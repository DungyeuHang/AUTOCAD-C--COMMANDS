# GHOPHOI - FIXTURE "BAY THU TU" (U-hook trap)
# Tai dung CreateOrderTrapRequest (AuditExperiments.cs): 2 U-hook 250x140 + 1 blocker 260x130, to 300x1200.
# V1 da bang nghiem tot nhat tren moi hoan vi (425 khong le = 430 co le cuoi).
SETTINGS gap=5 margin=5 mirror=0 rotations=0,90,180,270 inhole=0 seed=1 budget=30 extra=3
SHEET name=300x1200 length=1200 width=300
PART id=U_HOOK qty=2 material=1.2MM tol=0 name=U_HOOK
OUTER 0,0 250,0 250,140 180,140 180,50 70,50 70,140 0,140
END
PART id=BLOCKER qty=1 material=1.2MM tol=0 name=BLOCKER
OUTER 0,0 260,0 260,130 0,130
END
EXPECT placed=3 unplaced=0 sheets=1 usedlength<=431 mingap>=5 minedge>=5
